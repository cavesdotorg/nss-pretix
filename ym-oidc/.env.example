# YourMembership OAuth2 credentials (from YM admin panel)
YM_SITE_URL=https://members.caves.org
YM_APP_ID=your_ym_app_id
YM_APP_SECRET=your_ym_app_secret
YM_CLIENT_ID=12345                          # numeric YM site ID

# OIDC provider identity
OIDC_ISSUER=https://tickets.caves.org/oidc

# Credentials Pretix uses to talk to this service
# Generate: openssl rand -base64 32
OIDC_CLIENT_ID=pretix
OIDC_CLIENT_SECRET=

# Where YM sends the browser after login (must be registered in YM admin panel)
REDIRECT_URI=https://tickets.caves.org/oidc/callback

# Flask session signing key
# Generate: openssl rand -base64 32
SECRET_KEY=

# Path prefix for all routes (default: /oidc)
URL_PREFIX=/oidc

# Browser session duration for Caddy forward_auth gate (seconds, default 8h)
# SESSION_TTL=28800

# RSA key paths inside the container (mounted from ~/secrets/ym-oidc/)
KEY_PATH=/secrets/oidc.key
PUB_PATH=/secrets/oidc.pub
